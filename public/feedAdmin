<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Indicadores - Ouvidoria Hospitalar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans p-4 md:p-8">

    <header class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-800 pb-6 mb-8 gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-cyan-500 font-bold mb-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                Sincronizado com API Python & Firestore
            </div>
            <h1 class="text-3xl font-black text-white tracking-tight">Análise de Satisfação Hospitalar</h1>
        </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-6">
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
                <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Total de Votos</div>
                <div id="kpi-total" class="text-4xl font-black text-white mt-2">...</div>
            </div>
            <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
                <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Média de Satisfação</div>
                <div id="kpi-media" class="text-4xl font-black text-cyan-400 mt-2">...</div>
            </div>
            <div id="card-alerta" class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
                <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Status Operacional</div>
                <div id="kpi-status" class="text-xl font-bold text-emerald-400 mt-3">Todos os setores estáveis</div>
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
                <h3 class="text-lg font-bold text-white mb-4">Volume de Notas por Classificação</h3>
                <div class="h-64"><canvas id="graficoNotas"></canvas></div>
            </div>
            <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
                <h3 class="text-lg font-bold text-white mb-4">Média por Setor</h3>
                <div class="h-64"><canvas id="graficoSetores"></canvas></div>
            </div>
        </section>
    </main>

    <script>
        let URL_API_GET = "sisitgestor2026.vercel.app";
        Chart.defaults.color = '#64748b';

        let chartNotas = null;
        let chartSetores = null;

        async function carregarDashboard() {
            try {
                const res = await fetch(URL_API_GET);
                const dados = await res.json();

                // Atualiza KPIs básicos
                document.getElementById('kpi-total').innerText = dados.total_votos;
                document.getElementById('kpi-media').innerText = dados.media_geral.toFixed(1) + " / 5.0";

                // Atualiza Alerta se houver setor com nota muito baixa (< 3.0)
                const setoresCriticos = Object.keys(dados.setores).filter(s => dados.setores[s].media < 3.0);
                if (setoresCriticos.length > 0) {
                    const box = document.getElementById('card-alerta');
                    box.className = "bg-red-950/20 border border-red-900 p-6 rounded-2xl shadow-xl";
                    document.getElementById('kpi-status').className = "text-xl font-bold text-red-400 mt-3";
                    document.getElementById('kpi-status').innerText = `Atenção no ${setoresCriticos[0]}`;
                }

                // Renderiza ou Atualiza Gráfico 1 (Notas)
                const ctxNotas = document.getElementById('graficoNotas').getContext('2d');
                if(chartNotas) chartNotas.destroy();
                chartNotas = new Chart(ctxNotas, {
                    type: 'bar',
                    data: {
                        labels: Object.keys(dados.distribuicao_notas),
                        datasets: [{ data: Object.values(dados.distribuicao_notas), backgroundColor: '#22d3ee', borderRadius: 6 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
                });

                // Renderiza ou Atualiza Gráfico 2 (Setores)
                const ctxSetores = document.getElementById('graficoSetores').getContext('2d');
                const mediasSetores = Object.keys(dados.setores).map(s => dados.setores[s].media);
                if(chartSetores) chartSetores.destroy();
                chartSetores = new Chart(ctxSetores, {
                    type: 'bar',
                    data: {
                        labels: Object.keys(dados.setores),
                        datasets: [{ data: mediasSetores, backgroundColor: ['#ef4444', '#34d399', '#22d3ee', '#a78bfa'], borderRadius: 6 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 5 } } }
                });

            } catch (err) { console.error("Erro ao carregar dados do Dashboard:", err); }
        }

        // Carrega imediatamente ao abrir e atualiza a cada 15 segundos
        carregarDashboard();
        setInterval(carregarDashboard, 15000);
    </script>
</body>
</html>
