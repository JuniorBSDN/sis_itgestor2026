<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Login | TI Hospitalar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0f172a; font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-white">Acesso Restrito</h1>
            <p class="text-slate-400 text-sm">Insira a credencial de suporte</p>
        </div>

        <form onsubmit="verificarLogin(event)" class="space-y-4">
            <input type="password" id="senha" placeholder="Digite a senha..."
                   class="w-full p-4 bg-slate-800 border border-slate-700 rounded-xl text-white outline-none focus:border-blue-500 transition-all">
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-xl transition-all shadow-lg shadow-blue-900/40">
                ACESSAR SISTEMA
            </button>
        </form>
        <p id="erro" class="text-red-500 text-xs text-center mt-4 hidden">Senha incorreta. Tente novamente.</p>
    </div>



    <script>
        function verificarLogin(e) {
            e.preventDefault();
            const senha = document.getElementById('senha').value;
            if (senha === '#suportetihmv') {
                sessionStorage.setItem('auth_ti', 'true');
                window.location.href = 'index.html';
            } else {
                document.getElementById('erro').classList.remove('hidden');
            }
        }

        async function verificarLogin(e) {
    e.preventDefault();
    const senha = document.getElementById('senha').value;
    const btn = e.target.querySelector('button');

    btn.innerText = "VERIFICANDO...";

    try {
        const response = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ senha: senha })
        });

        const resultado = await response.json();

        if (response.ok) {
            // Salva o token que o backend confirmou
            sessionStorage.setItem('auth_ti', resultado.token);
            window.location.href = 'index.html';
        } else {
            document.getElementById('erro').classList.remove('hidden');
        }
    } catch (err) {
        alert("Erro ao conectar com o servidor.");
    } finally {
        btn.innerText = "ACESSAR SISTEMA";
    }
}
    </script>
</body>
</html>
